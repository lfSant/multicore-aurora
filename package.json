{
  "name": "@multicore/lib",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.mjs",
      "require": "./dist/core/index.cjs"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.mjs",
      "require": "./dist/adapters/index.cjs"
    },
    "./sdk/client": {
      "types": "./dist/sdk/client/index.d.ts",
      "import": "./dist/sdk/client/index.mjs",
      "require": "./dist/sdk/client/index.cjs"
    },
    "./sdk/auth": {
      "types": "./dist/sdk/auth/index.d.ts",
      "import": "./dist/sdk/auth/index.mjs",
      "require": "./dist/sdk/auth/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup ./src/core/index.ts ./src/adapters/index.ts --dts --format cjs,esm --clean --tsconfig tsconfig.lib.json",
    "clean": "rimraf dist"
  },
  "tsup": { "tsconfig": "tsconfig.lib.json" },
  "dependencies": {
    "axios": "^1.7.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0"
  }
}