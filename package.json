{
  "name": "lib-multicore-aurora",
  "version": "1.0.0",
  "description": "Libreria TypeScript para la gestión de múltiples conexiones de manera dinamica a los cores de las cooperativas",
  "author": "Luis Fernando Santacruz",
  "email": "lf.santacruz@outlook.es",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lfSant/multicore-aurora.git"
  },
  "bugs": {
    "url": "https://github.com/lfSant/multicore-aurora/issues"
  },
  "homepage": "https://github.com/lfSant/multicore-aurora#readme",
  "keywords": [
    "multicore",
    "banking",
    "connector",
    "cooperative",
    "dynamic-adapter"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.mjs",
      "require": "./dist/core/index.cjs"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.mjs",
      "require": "./dist/adapters/index.cjs"
    },
    "./sdk/client": {
      "types": "./dist/sdk/client/index.d.ts",
      "import": "./dist/sdk/client/index.mjs",
      "require": "./dist/sdk/client/index.cjs"
    },
    "./sdk/auth": {
      "types": "./dist/sdk/auth/index.d.ts",
      "import": "./dist/sdk/auth/index.mjs",
      "require": "./dist/sdk/auth/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup ./src/core/index.ts ./src/adapters/index.ts --dts --format cjs,esm --clean --tsconfig tsconfig.lib.json",
    "clean": "rimraf dist"
  },
  "tsup": {
    "tsconfig": "tsconfig.lib.json"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "ioredis": "5.8.0",
    "lodash.get": "^4.4.2",
    "mysql2": "^3.15.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/lodash.get": "^4.4.9",
    "@types/node": "^24.5.2",
    "rimraf": "^6.0.1",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0"
  }
}
