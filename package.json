{
  "name": "lib-multicore-aurora",
  "version": "3.0.49",
  "description": "Libreria TypeScript para la gestión de múltiples conexiones de manera dinamica a los cores de las cooperativas",
  "author": "Luis Fernando Santacruz",
  "email": "lf.santacruz@outlook.es",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lfSant/multicore-aurora.git"
  },
  "bugs": {
    "url": "https://github.com/lfSant/multicore-aurora/issues"
  },
  "homepage": "https://github.com/lfSant/multicore-aurora#readme",
  "keywords": [
    "multicore",
    "banking",
    "connector",
    "cooperative",
    "dynamic-adapter"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.cjs"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js",
      "require": "./dist/adapters/index.cjs"
    },
    "./sdk": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk/index.js",
      "require": "./dist/sdk/index.cjs"
    },
    "./sdk/client": {
      "types": "./dist/sdk/client/index.d.ts",
      "import": "./dist/sdk/client/index.js",
      "require": "./dist/sdk/client/index.cjs"
    },
    "./sdk/auth": {
      "types": "./dist/sdk/auth/index.d.ts",
      "import": "./dist/sdk/auth/index.js",
      "require": "./dist/sdk/auth/index.cjs"
    },
    "./sdk/account": {
      "types": "./dist/sdk/account/index.d.ts",
      "import": "./dist/sdk/account/index.js",
      "require": "./dist/sdk/account/index.cjs"
    },
    "./sdk/catalog": {
      "types": "./dist/sdk/catalog/index.d.ts",
      "import": "./dist/sdk/catalog/index.js",
      "require": "./dist/sdk/catalog/index.cjs"
    },
    "./sdk/payment": {
      "types": "./dist/sdk/payment/index.d.ts",
      "import": "./dist/sdk/payment/index.js",
      "require": "./dist/sdk/payment/index.cjs"
    },
    "./sdk/transfer": {
      "types": "./dist/sdk/transfer/index.d.ts",
      "import": "./dist/sdk/transfer/index.js",
      "require": "./dist/sdk/transfer/index.cjs"
    },
    "./sdk/product": {
      "types": "./dist/sdk/product/index.d.ts",
      "import": "./dist/sdk/product/index.js",
      "require": "./dist/sdk/product/index.cjs"
    },
    "./sdk/causal": {
      "types": "./dist/sdk/causal/index.d.ts",
      "import": "./dist/sdk/causal/index.js",
      "require": "./dist/sdk/causal/index.cjs"
    },
    "./sdk/user": {
      "types": "./dist/sdk/user/index.d.ts",
      "import": "./dist/sdk/user/index.js",
      "require": "./dist/sdk/user/index.cjs"
    },
    "./sdk/deposit": {
      "types": "./dist/sdk/deposit/index.d.ts",
      "import": "./dist/sdk/deposit/index.js",
      "require": "./dist/sdk/deposit/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup ./src/index.ts ./src/core/index.ts ./src/adapters/index.ts ./src/sdk/index.ts ./src/sdk/client/index.ts ./src/sdk/auth/index.ts ./src/sdk/account/index.ts ./src/sdk/catalog/index.ts ./src/sdk/payment/index.ts ./src/sdk/transfer/index.ts ./src/sdk/product/index.ts ./src/sdk/causal/index.ts ./src/sdk/user/index.ts ./src/sdk/deposit/index.ts --dts --format cjs,esm --clean --tsconfig tsconfig.lib.json --minify terser",
    "clean": "rimraf dist",
    "prepublishOnly": "yarn clean && yarn build",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "version:patch-est": "npm version patch --no-git-tag-version && git tag $(node -p \"require('./package.json').version\")-st",
    "version:minor-est": "npm version minor --no-git-tag-version && git tag $(node -p \"require('./package.json').version\")-st",
    "version:major-est": "npm version major --no-git-tag-version && git tag $(node -p \"require('./package.json').version\")-st",
    "deploy:develop-est": "git add src/ package.json README.md && (git diff --staged --quiet || git commit -m 'chore: update develop_stabilization') && git push origin develop_stabilization",
    "deploy:release-est": "yarn build && DIST_TMP=$(mktemp -d) && cp -r dist/* $DIST_TMP/ && git checkout release-testing && rm -rf dist && mkdir -p dist && cp -r $DIST_TMP/* dist/ && rm -rf $DIST_TMP && git checkout develop_stabilization -- package.json && git add -f dist/ package.json && (git diff --staged --quiet && echo 'No changes to deploy' || (VERSION=$(node -p \"require('./package.json').version\") && git commit -m \"chore(release-testing): update dist v$VERSION\" && git tag \"v$VERSION\" && git push github release-testing --tags)) && git checkout develop_stabilization",
    "deploy:all-est": "yarn version:patch-est && yarn deploy:develop-est && yarn deploy:release-est",
    "deploy:develop": "git add src/ package.json README.md && (git diff --staged --quiet || git commit -m 'chore: update develop') && git push origin develop",
    "deploy:release": "yarn build && DIST_TMP=$(mktemp -d) && cp -r dist/* $DIST_TMP/ && git checkout release && rm -rf dist && mkdir -p dist && cp -r $DIST_TMP/* dist/ && rm -rf $DIST_TMP && git checkout develop -- package.json && git add -f dist/ package.json && (git diff --staged --quiet && echo 'No changes to deploy' || (VERSION=$(node -p \"require('./package.json').version\") && git commit -m \"chore(release): update dist v$VERSION\" && git tag \"v$VERSION\" && git push github release --tags)) && git checkout develop",
    "deploy:all": "yarn version:patch && yarn deploy:develop && yarn deploy:release"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "tsup": {
    "tsconfig": "tsconfig.lib.json"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "ioredis": "5.8.0",
    "mysql2": "^3.15.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "rimraf": "^6.0.1",
    "terser": "^5.44.1",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0"
  }
}
